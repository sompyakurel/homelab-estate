# homelab-estate — environment template
# Copy to .env and fill in your own values. NEVER commit a filled-in .env.
# The .gitignore in this repo excludes .env, *.key, and token files.

# Home Assistant (CT 106)
HA_HOST=http://192.168.1.26:8123
# Long-lived access token — create in HA: Profile -> Long-Lived Access Tokens.
# Stored in ~/.ha-token (chmod 600) on the machine that runs the board driver.
HA_TOKEN_FILE=~/.ha-token

# Immich (CT 104)
IMMICH_HOST=http://192.168.1.24:2283
# API key with asset.read + asset.view + person.read — stored in ~/.immich-board-key
IMMICH_KEY_FILE=~/.immich-board-key

# MQTT broker (Mosquitto on CT 105)
MQTT_BROKER_HOST=192.168.1.25
MQTT_BROKER_PORT=1883

# Frigate cameras (see frigate/config.yml — credentials are ${VAR} there)
# Tapo camera account (C120, RTSP/ONVIF). The username is the Tapo
# account email; the password is the camera account password.
TAPO_USER=you@example.com
TAPO_PASSWORD=
# NVR (XiongMai/ASECAM, RTSP). Username is the NVR login; do NOT change
# the NVR device password — it is set on the device itself.
NVR_USER=pyakscam
NVR_PASSWORD=

# Night watchman mail (see watchman/watchman-mail.py)
WATCHMAN_FROM=Night Watchman <watchman@example.com>
WATCHMAN_TO=you@example.com

# Board hosting backend (Ghar backend, Fly.io)
# Upload token is a Fly secret (BOARD_UPLOAD_TOKEN); the deploy machine
# reads it from the Secure Vault connector, never from this repo.
BOARD_BACKEND=https://backend-patient-wave-3724.fly.dev

# Voice Monkey (Echo Show 11 announcements)
# Token + Speaker device id — stored in ~/.voicemonkey-token and
# ~/.voicemonkey-device (chmod 600). Free plan: 200 requests/month.
VOICEMONKEY_TOKEN_FILE=~/.voicemonkey-token
VOICEMONKEY_DEVICE_FILE=~/.voicemonkey-device

# AI receptionist (CT 105)
# Gemini API key — stored in /root/.gemini-api-key (chmod 600) on CT 105.
GEMINI_KEY_FILE=/root/.gemini-api-key
